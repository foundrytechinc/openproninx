# Build output
obj/
*.o
*.a
*.d
*.asm
*.sym
*.bin
*.img
kern/vectors.S

# Generated boot and kernel blobs
bootblock
entryother
kernel
kernelmemfs
mkfs

# run artefacts
qemu.log

# Editor leftovers
*~
_*

# needed, though the patterns above would take them
!etc/rc.d/
!include/**/_*.h
!lib/libc/**/_*
!makefs/**/_*.h

# reference sources, read only, never built
refs/

# third-party downloads not part of the build
third_party/src/curl-*/
third_party/src/nano-*/

# nginx FNU port: keep config headers, drop build products
third_party/src/nginx-1.27.4/objs/**/*.o
third_party/src/nginx-1.27.4/objs/nginx
third_party/src/nginx-1.27.4/objs/autoconf.err

# joe: unicode tables for regenerating unicat (not needed to build)
third_party/src/joe-releases-joe-4.8/joe/util/

# bundled makefs: build the binary locally (makefs/.gitignore covers *.o)
makefs/src/usr.sbin/makefs/makefs


# third-party port sources — local only, never committed
third_party/src/nginx-*/
third_party/src/joe-*/
